{
  "name": "ashutosh-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/routes.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node scripts/check-source.mjs",
    "check:build": "node scripts/check-build.mjs",
    "test": "node --test tests/*.test.js",
    "validate": "npm run check && npm test && npm run build && npm run check:build"
  },
  "dependencies": { "three": "0.180.0" },
  "devDependencies": { "vite": "7.3.7" }
}
